<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- GETIR API FORM VIEW -->
    <record id="view_getir_api_form" model="ir.ui.view">
        <field name="name">getir.api.form</field>
        <field name="model">getir.api</field>
        <field name="arch" type="xml">
            <form string="Getir API Settings">
                <header>
                    <!-- Login -->
                    <button name="action_login" type="object" class="btn-primary" string="🔑 Token Al"/>
                    <separator/>
                    <!-- Menu Sync -->
                    <button name="action_sync_menu" type="object" class="btn-info" string="📥 Menüyü Güncelle"/>
                    <separator/>
                    <!-- POS Status -->
                    <button name="action_activate_pos" type="object" class="btn-success" string="✓ POS Aktif"/>
                    <button name="action_deactivate_pos" type="object" class="btn-warning" string="✗ POS Pasif"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="API Ayarları">
                            <field name="api_url"/>
                            <field name="app_secret_key" password="True"/>
                            <field name="restaurant_secret_key" password="True"/>
                            <field name="active"/>
                        </group>
                        <group string="Token Bilgisi">
                            <field name="token" readonly="1"/>
                            <field name="token_expire" readonly="1"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Restoran Kontrolü" name="restaurant_control">
                            <group string="Yoğunluk Modu (+dk teslimat süresi)">
                                <div class="o_row">
                                    <button name="action_set_busy_15" type="object" class="btn-secondary" string="+15 dk"/>
                                    <button name="action_set_busy_30" type="object" class="btn-secondary" string="+30 dk"/>
                                    <button name="action_set_busy_45" type="object" class="btn-secondary" string="+45 dk"/>
                                    <button name="action_clear_busy" type="object" class="btn-outline-secondary" string="Yoğunluk Kapat"/>
                                </div>
                            </group>
                            <group string="Geçici Kapama">
                                <div class="o_row">
                                    <button name="action_close_15" type="object" class="btn-warning" string="15 dk Kapat"/>
                                    <button name="action_close_30" type="object" class="btn-warning" string="30 dk Kapat"/>
                                    <button name="action_close_45" type="object" class="btn-warning" string="45 dk Kapat"/>
                                </div>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- GETIR API LIST VIEW -->
    <record id="view_getir_api_list" model="ir.ui.view">
        <field name="name">getir.api.list</field>
        <field name="model">getir.api</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="api_url"/>
                <field name="token"/>
                <field name="token_expire"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_getir_api_list" model="ir.actions.act_window">
        <field name="name">API Ayarları</field>
        <field name="res_model">getir.api</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
