<odoo>
    <record id="view_getir_api_form" model="ir.ui.view">
        <field name="name">getir.api.form</field>
        <field name="model">getir.api</field>
        <field name="arch" type="xml">
            <form string="Getir API Settings">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="api_url"/>
                        <field name="app_secret_key"/>
                        <field name="restaurant_secret_key"/>
                        <field name="token" readonly="1"/>
                        <field name="token_expire" readonly="1"/>
                    </group>
                    <footer>
                        <button name="action_login" type="object" class="btn-primary" string="Login (Token Al)"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_getir_api_list" model="ir.ui.view">
        <field name="name">getir.api.list</field>
        <field name="model">getir.api</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="api_url"/>
                <field name="token"/>
                <field name="token_expire"/>
            </list>
        </field>
    </record>

    <record id="action_getir_api_list" model="ir.actions.act_window">
        <field name="name">API Ayarları</field>
        <field name="res_model">getir.api</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
