<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================ -->
    <!-- PRODUCT MAP VIEWS -->
    <!-- ============================================ -->

    <!-- PRODUCT MAP LIST -->
    <record id="view_getir_product_map_list" model="ir.ui.view">
        <field name="name">getir.product.map.list</field>
        <field name="model">getir.product.map</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="getir_product_id"/>
                <field name="getir_chain_product_id"/>
                <field name="product_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- PRODUCT MAP FORM -->
    <record id="view_getir_product_map_form" model="ir.ui.view">
        <field name="name">getir.product.map.form</field>
        <field name="model">getir.product.map</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="getir_product_id"/>
                        <field name="getir_chain_product_id"/>
                        <field name="product_id"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION: getir.product.map -->
    <record id="action_getir_product_map" model="ir.actions.act_window">
        <field name="name">Product Mapping</field>
        <field name="res_model">getir.product.map</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============================================ -->
    <!-- MAIN MENU STRUCTURE -->
    <!-- ============================================ -->

    <!-- ROOT MENU -->
    <menuitem id="menu_getir_root"
              name="Getir Connector"
              parent="point_of_sale.menu_point_root"
              sequence="99"/>

    <!-- SUBMENU : Orders -->
    <menuitem id="menu_getir_orders"
              name="Siparişler"
              parent="menu_getir_root"
              action="action_getir_orders"
              sequence="1"/>

    <!-- SUBMENU : Menu Sync Parent -->
    <menuitem id="menu_getir_menu_parent"
              name="Menü Yönetimi"
              parent="menu_getir_root"
              sequence="2"/>

    <!-- SUBMENU : Menu Sync -->
    <menuitem id="menu_getir_menu_sync"
              name="Menü Senkronizasyonu"
              parent="menu_getir_menu_parent"
              action="action_getir_menu_sync"
              sequence="1"/>

    <!-- SUBMENU : Menu Items -->
    <menuitem id="menu_getir_menu_items"
              name="Menü Ürünleri"
              parent="menu_getir_menu_parent"
              action="action_getir_menu_items"
              sequence="2"/>

    <!-- SUBMENU : Menu Options -->
    <menuitem id="menu_getir_menu_options"
              name="Menü Opsiyonları"
              parent="menu_getir_menu_parent"
              action="action_getir_menu_options"
              sequence="3"/>

    <!-- SUBMENU : Menu Categories -->
    <menuitem id="menu_getir_menu_categories"
              name="Menü Kategorileri"
              parent="menu_getir_menu_parent"
              action="action_getir_menu_categories"
              sequence="4"/>

    <!-- SUBMENU : Product Mapping -->
    <menuitem id="menu_getir_product_map"
              name="Product Mapping"
              parent="menu_getir_menu_parent"
              action="action_getir_product_map"
              sequence="5"/>

    <!-- SUBMENU : Logs -->
    <menuitem id="menu_getir_logs"
              name="Loglar"
              parent="menu_getir_root"
              action="action_getir_log_list"
              sequence="10"/>

    <!-- SUBMENU : API Settings -->
    <menuitem id="menu_getir_api_settings"
              name="API Ayarları"
              parent="menu_getir_root"
              action="action_getir_api_list"
              sequence="20"/>

    <!-- SUBMENU : Cancel Reasons -->
    <menuitem id="menu_getir_cancel_reasons"
              name="İptal Sebepleri"
              parent="menu_getir_root"
              action="action_getir_cancel_reason"
              sequence="21"/>

</odoo>
