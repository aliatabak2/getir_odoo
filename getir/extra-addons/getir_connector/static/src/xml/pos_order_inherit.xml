<odoo>
    <templates id="template" xml:space="preserve">

        <!-- OrderList item’ına GETIR badge ekleme -->
        <t t-inherit="point_of_sale.OrderList" t-inherit-mode="extension" owl="1">
            <!-- order satırının içini bulup badge ekliyoruz -->
            <xpath expr=".//div[contains(@class, 'order-line')]" position="inside">
                <!-- JavaScript'te order.ref veya order.pos_reference 'Getir-' ile başlıyorsa -->
                <t t-if="order && ((order.ref and order.ref.indexOf('Getir-') === 0) or (order.pos_reference and order.pos_reference.indexOf('Getir-') === 0) or order.is_getir_order)">
                    <span class="badge bg-warning" title="Getir Siparişi" style="margin-left: 6px;">
                        Getir
                    </span>
                </t>
            </xpath>
        </t>

    </templates>
</odoo>
